{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  },
  "Jwt": {
    "Issuer": "demo-app",
    "Audience": "demo-app",
    "LifetimeMinutes": 30
  },
  "Network": {
    "Cors": {
      "AllowedOrigins": [ "https://notes.example.com" ]
    },
    "Outbound": {
      "AllowedHosts": [ "en.wikipedia.org", "api.github.com" ],
      "TimeoutSeconds": 5,
      "MaxResponseBytes": 262144
    },
    "ForwardedHeaders": {
      "KnownProxies": [ "10.20.0.10" ]
    },
    "InternalNetworks": [ "10.20.0.0/16" ]
  }
}
